{
  "name": "mufahras",
  "private": true,
  "version": "0.1.0",
  "description": "Find any verse of the Quran or hadith of the six major collections as you type. Works offline.",
  "license": "MIT",
  "homepage": "https://omeiirr.github.io/mufahras/",
  "repository": {
    "type": "git",
    "url": "https://github.com/omeiirr/mufahras.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run data && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "data:fetch": "tsx scripts/fetch-hadith.ts && tsx scripts/fetch-model.ts",
    "data": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/build-data.ts && NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/build-meaning.ts",
    "e2e": "playwright test",
    "wasm": "tsx scripts/build-wasm.ts",
    "welcome:shots": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/welcome-shots.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-naskh-arabic": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "@huggingface/tokenizers": "0.2.0",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@lucide/svelte": "^1.61.0",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.5",
    "d3-force": "^3.0.0",
    "fflate": "^0.8.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wabt": "1.0.39",
    "workbox-window": "^7.4.1"
  }
}
